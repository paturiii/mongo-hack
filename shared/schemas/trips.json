{
  "bsonType": "object",
  "required": ["_id", "user_id", "status"],
  "properties": {
    "_id": {"bsonType": "string", "pattern": "^trip_"},
    "user_id": {"bsonType": "string"},
    "session_id": {"bsonType": "string"},
    "origin": {"bsonType": ["object", "null"]},
    "destination": {
      "bsonType": ["object", "null"],
      "properties": {
        "name": {"bsonType": "string"},
        "country": {"bsonType": ["string", "null"]},
        "geo": {"bsonType": ["object", "null"]}
      }
    },
    "dates": {"bsonType": ["object", "null"]},
    "travelers": {"bsonType": ["int", "null"]},
    "legs": {"bsonType": "array"},
    "profile": {"bsonType": "object"},
    "status": {"enum": ["intake", "ready_for_research", "researching", "planned", "traveling", "done"]},
    "board_id": {"bsonType": ["string", "null"]}
  }
}

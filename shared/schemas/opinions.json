{
  "bsonType": "object",
  "required": ["_id", "city", "source_type", "source_url", "summary", "stance", "sentiment", "weight", "fetched_at"],
  "properties": {
    "_id": {"bsonType": "string"},
    "place_id": {"bsonType": ["string", "null"]},
    "city": {"bsonType": "string"},
    "source_type": {"enum": ["reddit", "forum", "blog", "review", "video", "news"]},
    "source_name": {"bsonType": ["string", "null"]},
    "source_url": {"bsonType": "string", "pattern": "^https?://"},
    "source_title": {"bsonType": ["string", "null"]},
    "summary": {"bsonType": "string", "minLength": 1, "maxLength": 600},
    "quote": {"bsonType": ["string", "null"], "pattern": "^\\s*(\\S+\\s+){0,19}\\S*\\s*$"},
    "stance": {"enum": ["pro", "con", "tip"]},
    "sentiment": {"bsonType": ["double", "int"], "minimum": -1, "maximum": 1},
    "tags": {"bsonType": "array"},
    "weight": {"bsonType": ["double", "int"]},
    "fetched_at": {"bsonType": "date"},
    "expires_at": {"bsonType": "date"}
  }
}

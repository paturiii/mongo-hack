{
  "bsonType": "object",
  "required": ["_id", "trip_id", "version", "share_slug", "title", "summary", "days", "bookings", "checklist_progress", "updated_at"],
  "properties": {
    "_id": {"bsonType": "string", "pattern": "^b_"},
    "trip_id": {"bsonType": "string"},
    "user_id": {"bsonType": ["string", "null"]},
    "version": {"bsonType": "int", "minimum": 1},
    "share_slug": {"bsonType": "string", "minLength": 6},
    "title": {"bsonType": "string"},
    "summary": {"bsonType": "string"},
    "checklist_progress": {
      "bsonType": "object",
      "required": ["booked", "total"],
      "properties": {"booked": {"bsonType": "int"}, "total": {"bsonType": "int"}}
    },
    "days": {
      "bsonType": "array",
      "minItems": 1,
      "items": {
        "bsonType": "object",
        "required": ["date", "theme", "slots"],
        "properties": {
          "date": {"bsonType": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "theme": {"bsonType": "string"},
          "area_geo": {"bsonType": ["object", "null"]},
          "weather_hint": {"bsonType": ["string", "null"]},
          "slots": {
            "bsonType": "array",
            "items": {
              "bsonType": "object",
              "required": ["slot_id", "time", "item"],
              "properties": {
                "slot_id": {"bsonType": "string"},
                "time": {"bsonType": "string", "pattern": "^\\d{2}:\\d{2}$"},
                "item": {
                  "bsonType": "object",
                  "required": ["name", "why", "opinion_chips", "link_ids", "sources"],
                  "properties": {
                    "place_id": {"bsonType": ["string", "null"]},
                    "name": {"bsonType": "string"},
                    "why": {"bsonType": "string"},
                    "opinion_chips": {
                      "bsonType": "array",
                      "items": {
                        "bsonType": "object",
                        "required": ["text", "source_type", "url"],
                        "properties": {"url": {"bsonType": "string", "pattern": "^https?://"}}
                      }
                    },
                    "link_ids": {"bsonType": "array"},
                    "sources": {
                      "bsonType": "array",
                      "minItems": 1,
                      "items": {"bsonType": "object", "required": ["source_type", "url"]}
                    },
                    "est_cost": {"bsonType": ["object", "null"]}
                  }
                }
              }
            }
          }
        }
      }
    },
    "bookings": {
      "bsonType": "array",
      "items": {
        "bsonType": "object",
        "required": ["link_id", "kind", "label", "url", "status"],
        "properties": {
          "url": {"bsonType": "string", "pattern": "^https?://"},
          "status": {"enum": ["todo", "user_marked_booked"]}
        }
      }
    },
    "updated_at": {"bsonType": "date"}
  }
}

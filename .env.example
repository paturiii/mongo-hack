# Copy to .env and fill in. Never commit .env.
# Run `python scripts/check_env.py` after filling.

# ============ REQUIRED (app will not start without these) ============

# --- MongoDB Atlas (own DB user per member, readWrite on wander) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=wander
MONGODB_DB=wander

# --- LLM backend (provider-agnostic, two tiers) ---
# FAST  = cheap, high-volume: opinion extraction, classification, disruption triage
# SMART = best reasoning: intake/questions, planning, refine scoping, native chat
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=                        # openrouter.ai/keys
LLM_MODEL_FAST=openai/gpt-6.1-terra
LLM_MODEL_SMART=openai/gpt-6.1-terra

# --- Voyage AI (embeddings + rerank; 200M free tokens, add payment method for Tier 1) ---
VOYAGE_API_KEY=
VOYAGE_EMBED_MODEL=voyage-3.5
VOYAGE_RERANK_MODEL=rerank-2.5

# --- Mode: fixtures (Mongo + LLM + Voyage only) | seeded | live ---
WANDER_MODE=fixtures

# ============ LIVE RESEARCH (Track 3) ============
SEARCH_PROVIDER=tavily              # tavily | exa | brave
SEARCH_API_KEY=
PLACES_PROVIDER=osm                 # google | foursquare | osm (osm needs no key)
PLACES_API_KEY=
TICKETMASTER_API_KEY=

# ============ DISRUPTION (Track 1) ============
FLIGHT_STATUS_PROVIDER=aviationstack   # aviationstack | aeroapi
FLIGHT_STATUS_API_KEY=
RESEND_API_KEY=
# Resend send-only keys work. Use a verified sender for real travelers.
RESEND_FROM_EMAIL=Wander <onboarding@resend.dev>
# Fixture/live-alert test recipient only (never committed personal addresses).
DISRUPTION_TEST_EMAIL=
WEB_BASE_URL=http://localhost:3000
# Weather: Open-Meteo, no key needed

# ============ VOICE (ElevenLabs, Tracks 1 + 2) ============
# Key must NOT be restricted (or enable: TTS, Voices read, Models read, ConvAI write, User read)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                # Voices -> pick one -> copy ID (Track 1 briefings + agent)
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_AGENT_ID=                # Conversational AI -> create agent "Wander" (Track 2 voice intake)

# Auth is plain MongoDB (users + auth_sessions), no auth env vars needed.

# ============ WEB (Next.js, browser-exposed: no secrets here) ============
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ============ PHASE 2 ONLY (plugin, not needed now) ============
# PUBLIC_BASE_URL=https://<your-domain>.ngrok-free.app
# NGROK_AUTHTOKEN=

# ============ OBSERVABILITY (LangSmith, $50 credits) ============
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=wander
